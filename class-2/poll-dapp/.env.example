# Red de Stellar a la que se conecta la dApp.
# Se leen en el navegador, por eso llevan el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Contrato de votación (contracts/poll) desplegado en Testnet.
# Se obtiene al desplegar, o con: stellar contract alias show poll --network testnet
NEXT_PUBLIC_CONTRACT_ID=CDW7LF5PLBAOZCIQFOERZGMRTWXHXKKGFPKUJT2B22BCSQQXS3GLHX63

# (Opcional) URL que muestra el QR para que el público entre a votar.
# Si no se define, el QR usa la dirección con la que abriste la página
# (en Vercel, la URL del deploy). Útil si usas un dominio propio.
# NEXT_PUBLIC_APP_URL=https://votacion.example.com
