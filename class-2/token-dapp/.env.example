# Red de Stellar a la que se conecta la dApp.
# Se leen en el navegador, por eso llevan el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Contrato de XLM nativo (Stellar Asset Contract, implementa SEP-41).
# Se obtiene con: stellar contract id asset --asset native --network testnet
NEXT_PUBLIC_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
